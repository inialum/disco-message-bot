{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "disco-message-bot",
	"compatibility_date": "2026-08-12",
	"workers_dev": false,
	"vars": {
		"ENVIRONMENT": "production"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	}
}
