{
	"name": "inialum-disco-message-bot",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"dev": "wrangler dev src/index.ts --port 7071",
		"deploy": "wrangler deploy --minify src/index.ts --keep-vars",
		"create-token": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/createToken.ts",
		"lint": "biome check",
		"fix": "biome check --write",
		"test": "vitest",
		"test:ci": "pnpm run test:coverage",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"typegen": "wrangler types --env-interface CloudflareBindings --strict-vars false"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.5.2",
		"@hono/zod-openapi": "^1.1.5",
		"hono": "^4.10.7",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/jws": "^3.2.10",
		"@vitest/coverage-v8": "^4.0.14",
		"discord-api-types": "^0.38.34",
		"dotenv": "^16.6.1",
		"jws": "^4.0.0",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vitest": "^4.0.14",
		"wrangler": "^4.51.0"
	},
	"packageManager": "pnpm@10.6.1+sha512.40ee09af407fa9fbb5fbfb8e1cb40fbb74c0af0c3e10e9224d7b53c7658528615b2c92450e74cfad91e3a2dcafe3ce4050d80bda71d757756d2ce2b66213e9a3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"workerd"
		]
	}
}
